{
  "name": "opencode-skill-lister",
  "version": "1.0.0-alpha.4",
  "description": "Lists available Skills in the OpenCode sidebar, showing name and description for each skill.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sidebar",
    "skills"
  ],
  "license": "AGPL-3.0",
  "author": "Ranjith Raj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjithrajv/opencode-skill-lister.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.build.config.ts && tsc --noEmit false --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "npm run build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "beta",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.0",
    "opencode-plugin-kit": "^1.0.0-alpha.5",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "^0.1.16",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.25 <2 || 0.0.0-beta-19242",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "opencode-plugin-kit": "^1.0.0-alpha.1",
    "solid-js": "^1.9.12"
  },
  "packageManager": "npm@11.19.1"
}
